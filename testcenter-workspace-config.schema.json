{
  "$id": "testcenter-workspace-config@0.1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Testcenter: Workspace-Config",
  "description": "Specification for central parameters of one Testcenter workspace.",
  "type": "object",
  "properties": {
    "workspaceName": {
      "description": "Language tagged name of the workspace",
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageTaggedString"
      },
      "minItems": 1
    },
    "workspaceDescription": {
      "description": "Language tagged description of the workspace",
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageTaggedString"
      },
      "minItems": 1
    },
    "globalLanguageFiles": {
      "description": "List of files to be used for i18n replacement. Booklets can use additional language files as overlay (replacement of specific text).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/languageTaggedString"
      },
      "minItems": 1
    },
    "bookletConfigs": {
      "description": "List of all configuration sets that can be used in that workspace.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/bookletConfig"
      }
    },
    "groupMonitorProfiles": {
      "description": "List of all settings that can be used in that workspace for group monitors.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/groupMonitorProfile"
      }
    },
    "loginDesigns": {
      "description": "List of all settings that can be used in that workspace for group monitors.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/loginDesign"
      }
    },
    "publicBooklets": {
      "description": "These booklets are listed on start page of the testcenter and do not need credentials. This can be used for demo items or open system checks.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lang": {
            "$ref": "#/$defs/languageCode"
          },
          "name": {
            "description": "The name will be used as title or button label.",
            "type": "string",
            "minLength": 3
          },
          "loginName": {
            "description": "Login to be used. This login must be found in any testtaker file of the workspace.",
            "type": "string",
            "minLength": 3
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "loginName"
        ]
      }
    }
  },
  "required": [
    "workspaceName"
  ],
  "additionalProperties": false,
  "$defs": {
    "languageCode": {
      "description": "ISO-language code",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]{2}$",
      "default": "de"
    },
    "languageTaggedString": {
      "type": "object",
      "properties": {
        "lang": {
          "$ref": "#/$defs/languageCode"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "lang",
        "value"
      ],
      "additionalProperties": false
    },
    "bookletConfig": {
      "description": "Configuration for one booklet",
      "type": "object",
      "properties": {
        "id": {
          "description": "ID to be used in booklets.",
          "type": "string",
          "minLength": 1
        },
        "useAsDefault": {
          "description": "If true, this config will be applied to all booklets without explicit config reference.",
          "type": "boolean",
          "default": false
        },
        "language": {
          "$ref": "#/$defs/languageCode"
        },
        "browser": {
          "description": "Browser settings",
          "type": "object",
          "properties": {
            "askForFullScreen": {
              "description": "If true, Testtaker will be prompted to set the browser full screen.",
              "type": "boolean",
              "default": false
            },
            "preventNavigationByBrowser": {
              "description": "<browserBehaviour> If true, the standard navigation handling (buttons) of the browser will not work.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "controller": {
          "description": "Test controller settings",
          "type": "object",
          "properties": {
            "forcePresentationComplete": {
              "description": "Precondition for leaving a unit: On presentation complete.",
              "type": "string",
              "enum": [
                "ON",
                "OFF",
                "ALWAYS"
              ],
              "default": "OFF"
            },
            "forceResponsesComplete": {
              "description": "Precondition for leaving a unit: On responses complete.",
              "type": "string",
              "enum": [
                "ON",
                "OFF",
                "ALWAYS"
              ],
              "default": "OFF"
            },
            "lazyLoading": {
              "description": "<loading_mode> If true, the first unit will be presented after loading the first block. If false, all content files must be loaded to start the booklet.",
              "type": "boolean",
              "default": true
            },
            "logPolicy": {
              "description": "Limit logging to prevent unnecessary traffic.",
              "type": "string",
              "enum": [
                "DISABLED",
                "LEAN",
                "RICH",
                "DEBUG"
              ],
              "default": "RICH"
            },
            "lockTestOnTermination": {
              "description": "If true, the test will be locked by termination request to prevent any changes.",
              "type": "boolean",
              "default": false
            },
            "silentMode": {
              "description": "If true, all messages for the testtaker will be supressed (no diversion).",
              "type": "boolean",
              "default": false
            },
            "sendBufferTime": {
              "description": "Time settings for the controller to wait before sending data to the backend (ms).",
              "type": "object",
              "properties": {
                "unitResponses": {
                  "type": "integer",
                  "default": 5000
                },
                "unitState": {
                  "type": "integer",
                  "default": 6000
                },
                "testState": {
                  "type": "integer",
                  "default": 1000
                }
              },
              "additionalProperties": false
            },
            "timeLeftWarnings": {
              "description": "Minutes before block time is over the controller will send a warning message to testtaker.",
              "type": "array",
              "items": {
                "type": "integer"
              },
              "default": [
                1,
                5
              ]
            }
          },
          "additionalProperties": false
        },
        "userInterface": {
          "description": "Elements on screen: content and behavoir",
          "type": "object",
          "properties": {
            "header": {
              "description": "<header_hidden/header_content> Sets the content of the top header area.",
              "type": "string",
              "enum": [
                "EMPTY",
                "OFF",
                "BOOKLET_LABEL",
                "BLOCK_LABEL",
                "UNIT_LABEL"
              ],
              "default": "UNIT_LABEL"
            },
            "mainForwardButton": {
              "description": "Behavoir of the primary navigation button: Forward",
              "type": "string",
              "enum": [
                "HIDDEN",
                "DYNAMIC",
                "UNITS",
                "PAGES"
              ],
              "default": "HIDDEN"
            },
            "mainBackwardButton": {
              "description": "Behavoir of the primary navigation button: Backward",
              "type": "string",
              "enum": [
                "HIDDEN",
                "DYNAMIC",
                "UNITS",
                "PAGES"
              ],
              "default": "HIDDEN"
            },
            "unitLabel": {
              "description": "Label to represent the unit",
              "type": "string",
              "enum": [
                "HIDDEN",
                "INDEX",
                "LABEL"
              ],
              "default": "INDEX"
            },
            "unitPages": {
              "description": "Elements for the pages of an unit",
              "type": "object",
              "properties": {
                "pageLabel": {
                  "description": "Label to represent the unit page(s)",
                  "type": "string",
                  "enum": [
                    "HIDDEN",
                    "INDEX",
                    "LABEL",
                    "LIST"
                  ],
                  "default": "INDEX"
                },
                "navigationButtons": {
                  "description": "If true, the unit page labels act as buttons for navigation between pages.",
                  "type": "boolean",
                  "default": true
                },
                "pagingMode": {
                  "description": "The value will be sent to the player to set its paging behavoir.",
                  "type": "string",
                  "enum": [
                    "SEPARATE",
                    "CONCAT_SCROLL",
                    "CONCAT_SCROLL_SNAP",
                    "BUTTONS"
                  ],
                  "default": "SEPARATE"
                },
                "restoreSelectedPageOnReturn": {
                  "description": "If true, the unit page selected before reload will be set as current.",
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            },
            "toolBar": {
              "description": "Elements on toolbar area",
              "type": "object",
              "properties": {
                "fullScreenButton": {
                  "type": "boolean",
                  "default": false
                },
                "reloadButton": {
                  "type": "boolean",
                  "default": false
                },
                "timeLeft": {
                  "type": "boolean",
                  "default": false
                },
                "unitList": {
                  "type": "boolean",
                  "default": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "groupMonitorProfile": {
      "type": "object",
      "description": "Settings for the view 'group monitor'.",
      "properties": {
        "id": {
          "description": "ID to be used in logins.",
          "type": "string",
          "minLength": 1
        },
        "useAsDefault": {
          "description": "If true, this profile will be applied to all group monitors without explicit profile reference.",
          "type": "boolean",
          "default": false
        },
        "columns": {
          "description": "Show columns in main table",
          "type": "object",
          "properties": {
            "block": {
              "type": "boolean",
              "default": false
            },
            "unit": {
              "type": "boolean",
              "default": false
            },
            "group": {
              "type": "boolean",
              "default": true
            },
            "booklet": {
              "type": "boolean",
              "default": false
            },
            "bookletStates": {
              "description": "This setting shows/hides the column of states a booklet can define. A booklet state contains a parameter 'show in group monitor' to be selected.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false
        },
        "detailView": {
          "type": "string",
          "description": "Number of details in view.",
          "enum": [
            "MAX",
            "MEDIUM",
            "MIN"
          ]
        },
        "presentBookletList": {
          "description": "Offers the booklets of the group to have a look at the test content.",
          "type": "string",
          "enum": [
            "OFF",
            "BUTTONS_LIST",
            "BUTTONS_LIST_COLLAPSED"
          ],
          "default": "OFF"
        },
        "autoselectNextBlock": {
          "description": "If true, the next block will be selected after a block operation. If no, the current block remains selected to prevent unintended operations.",
          "type": "boolean",
          "default": false
        },
        "testFilters": {
          "type": "object",
          "properties": {
            "pending": {
              "description": "If true, pending tests will be hidden.",
              "type": "boolean",
              "default": false
            },
            "locked": {
              "description": "If true, locked tests will be hidden.",
              "type": "boolean",
              "default": false
            },
            "conditionalFilters": {
              "description": "Rules operator is 'OR', so if one rule matches, the test will be hidden and the other rules are skipped.",
              "type": "array",
              "items": {
                "description": "If rule expression result is 'true', the test will be hidden.",
                "type": "object",
                "properties": {
                  "sourceProperty": {
                    "type": "string",
                    "enum": [
                      "BOOKLET_LABEL",
                      "PERSON_LABEL",
                      "STATE",
                      "BLOCK_LABEL",
                      "GROUP_NAME",
                      "BOOKLET_ID",
                      "UNIT_ID",
                      "UNIT_LABEL",
                      "BLOCK_ID",
                      "TEST_STATE",
                      "MODE",
                      "BOOKLET_SPECIES",
                      "BOOKLET_STATES"
                    ]
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "EQUALS",
                      "EQUALS_REGEX",
                      "CONTAINS",
                      "EQUALS_NOT",
                      "EQUALS_REGEX_NOT",
                      "CONTAINS_NOT"
                    ]
                  },
                  "methodParameter": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "sourceProperty",
                  "method",
                  "methodParameter"
                ]
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "loginDesign": {
      "description": "A set of parameters to be applied to a test design after logging in. If incomplete, the default or system wide design will be overwritten only partly.",
      "type": "object",
      "properties": {
        "id": {
          "description": "ID to be used in logins.",
          "type": "string",
          "minLength": 1
        },
        "useAsDefaultFor": {
          "description": "Scope this design is to be used as default. Any uncomplete design will overwrite this default only partly.",
          "type": "string",
          "enum": [
            "GROUP_MONITOR",
            "STUDY_MONITOR",
            "RUN",
            "SYSTEM_CHECK"
          ]
        },
        "styling": {
          "description": "Every testcenter installation holds sets of design parameters. With this property, you refer to one of these sets.",
          "type": "string",
          "enum": [
            "PRIMARY",
            "SECONDARY",
            "ADULT"
          ],
          "default": "SECONDARY"
        },
        "images": {
          "description": "These image files will replace default or system wide images.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "targetSlot": {
                "description": "Page slot where the image is placed into.",
                "type": "string",
                "enum": [
                  "APPLICATION_LOGO",
                  "CODE_INPUT_PROMPT",
                  "CODE_INPUT_COMPANION",
                  "LOGIN_FORM",
                  "STARTER_COMPANION",
                  "STARTER_CARD_DONE",
                  "LOADING_PROGRESS",
                  "CONFIRM_DIALOG"
                ]
              },
              "filename": {
                "description": "Name of the image file located in the workspace. If not found, the default image will be used.",
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "targetSlot",
              "filename"
            ]
          }
        },
        "codeInputMode": {
          "description": "Depending on the age of the testtaker, a special code input mode might be more suitable.",
          "type": "string",
          "enum": [
            "TEXT_FIELD",
            "KEYPAD_SYMBOLS",
            "KEYPAD_SYMBOLS_ALT",
            "KEYPAD_NUMBERS"
          ],
          "default": "TEXT_FIELD"
        },
        "codeInputFixLength": {
          "description": "If greater than 2 (minimum length is 3), the UI responses during code input in an appropriate way.",
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    }
  }
}